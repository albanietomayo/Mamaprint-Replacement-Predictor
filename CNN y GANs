        "# Callback interactivo de monitoreo de fotografías sintéticas\n",
        "class MonitorGAN(tf.keras.callbacks.Callback):\n",
        "    def __init__(self, num_img=5, latent_dim=100):\n",
        "        self.num_img = num_img\n",
        "        self.latent_dim = latent_dim\n",
        "        self.semilla_fija = tf.random.normal(shape=(self.num_img, self.latent_dim))\n",
        "\n",
        "    def on_epoch_end(self, epoch, logs=None):\n",
        "        # Visualizar cada 2 épocas\n",
        "        if (epoch + 1) % 2 == 0:\n",
        "            imagenes_generadas = self.model.generador(self.semilla_fija).numpy()\n",
        "\n",
        "            fig, axes = plt.subplots(1, self.num_img, figsize=(10, 2))\n",
        "            fig.suptitle(f'Lunares_Sinteticos - Época {epoch + 1}', fontsize=12)\n",
        "            for i in range(self.num_img):\n",
        "                img = (imagenes_generadas[i] + 1) / 2\n",
        "                axes[i].imshow(img)\n",
        "                axes[i].axis('off')\n",
        "            plt.show()"
