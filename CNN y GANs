        "### **2.4. Programar el modelo GAN y su train_step personalizado**\n",
        "\n",
        "Para entrenar adecuadamente nuestra GAN, crearemos un modelo unificado heredando de la clase de alto nivel `tf.keras.Model` y reescribiremos su método `train_step`. Completa el esqueleto rellenando los marcadores `???` o `????`:\n",
        "1.  El Generador toma como entrada el tensor `ruido` para crear `imagenes_falsas` en self.generador(????).\n",
        "2.  Evaluamos las imágenes (reales y falsas concatenadas) pasándoselas al discriminador en self.discriminador(????).\n",
        "3.  El generador intenta engañar al discriminador pasándole sus imágenes generadas en self.discriminador(self.generador(????))."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "Xs-wu5gG_Utf"
      },
      "source": [
        "# ESQUELETO DE TRAIN_STEP\n",
        "class ModeloGAN(Model):\n",
        "    def __init__(self, discriminador, generador, latent_dim):\n",
        "        super().__init__()\n",
        "        self.discriminador = discriminador\n",
        "        self.generador = generador\n",
        "        self.latent_dim = latent_dim\n",
        "\n",
        "    def compile(self, d_optimizer, g_optimizer, funcion_perdida):\n",
        "        super().compile()\n",
        "        self.d_optimizer = d_optimizer\n",
        "        self.g_optimizer = g_optimizer\n",
        "        self.funcion_perdida = funcion_perdida\n",
        "        self.d_loss_metric = tf.keras.metrics.Mean(name=\"d_loss\")\n",
        "        self.g_loss_metric = tf.keras.metrics.Mean(name=\"g_loss\")\n",
        "\n",
        "    @property\n",
        "    def metrics(self):\n",
        "        return [self.d_loss_metric, self.g_loss_metric]\n",
        "\n",
        "    def train_step(self, imagenes_reales):\n",
        "        batch_size = tf.shape(imagenes_reales)[0]\n",
        "\n",
        "        # =========================================================================\n",
        "        # 1. ENTRENAR EL DISCRIMINADOR\n",
        "        # =========================================================================\n",
        "        ruido = tf.random.normal(shape=(batch_size, self.latent_dim))\n",
        "\n",
        "        # Generar imágenes falsas\n",
        "        imagenes_falsas = self.generador(ruido) # RELLENAR: qué toma de entrada el generador?\n",
        "\n",
        "        # Concatenar reales y falsas\n",
        "        todas_las_imagenes = tf.concat([imagenes_reales, imagenes_falsas], axis=0)\n",
        "        etiquetas = tf.concat([tf.ones((batch_size, 1)), tf.zeros((batch_size, 1))], axis=0)\n",
        "        etiquetas += 0.05 * tf.random.uniform(tf.shape(etiquetas)) # Label smoothing\n",
        "\n",
        "        with tf.GradientTape() as tape:\n",
        "            # Evaluar imágenes reales y falsas\n",
        "            predicciones = self.discriminador(todas_las_imagenes) # RELLENAR: qué evalúa el discriminador?\n",
        "            d_loss = self.funcion_perdida(etiquetas, predicciones)\n",
        "\n",
        "        # Calcular y aplicar gradientes\n",
        "        gradientes = tape.gradient(d_loss, self.discriminador.trainable_variables)\n",
        "        self.d_optimizer.apply_gradients(zip(gradientes, self.discriminador.trainable_variables))\n",
        "\n",
        "        # =========================================================================\n",
        "        # 2. ENTRENAR EL GENERADOR\n",
        "        # =========================================================================\n",
        "        ruido = tf.random.normal(shape=(batch_size, self.latent_dim))\n",
        "        etiquetas_engaño = tf.ones((batch_size, 1)) # Intentamos engañar al discriminador\n",
        "\n",
        "        with tf.GradientTape() as tape:\n",
        "            # Intentar hacer que el discriminador clasifique las falsas como reales\n",
        "            predicciones_falsas = self.discriminador(self.generador(ruido)) # RELLENAR: qué toma el generador?\n",
        "            g_loss = self.funcion_perdida(etiquetas_engaño, predicciones_falsas)\n",
        "\n",
        "        # Calcular y aplicar gradientes\n",
        "        gradientes = tape.gradient(g_loss, self.generador.trainable_variables)\n",
        "        self.g_optimizer.apply_gradients(zip(gradientes, self.generador.trainable_variables))\n",
        "\n",
        "        # Actualizar métricas\n",
        "        self.d_loss_metric.update_state(d_loss)\n",
        "        self.g_loss_metric.update_state(g_loss)\n",
        "\n",
        "        return {\"d_loss\": self.d_loss_metric.result(), \"g_loss\": self.g_loss_metric.result()}\n",
        "\n",
        "# Instanciar el esqueleto para comprobar\n",
        "gan_model = ModeloGAN(discriminador=discriminator_64, generador=generator_64, latent_dim=100)"
      ],
