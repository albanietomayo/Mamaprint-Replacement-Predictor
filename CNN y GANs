      "cell_type": "code",
      "metadata": {
        "id": "iexBMC4iWXbK"
      },
      "source": [
        "# ESQUELETO CNN (Completa los ???)\n",
        "class CNNClasificador():\n",
        "    def build_model():\n",
        "        # 1. Definir el tamaño de entrada de la imagen (con canal)\n",
        "        inputs = Input((64, 64, 1))\n",
        "\n",
        "        # Bloque Convolucional 1: Conv2D + MaxPooling\n",
        "        conv1 = Conv2D(filters=32, kernel_size=(3, 3), activation='relu', padding='same')(inputs)\n",
        "        pool1 = MaxPooling2D(pool_size=(2, 2))(conv1)\n",
        "\n",
        "        # Bloque Convolucional 2: Conv2D + MaxPooling\n",
        "        conv2 = Conv2D(filters=64, kernel_size=(3, 3), activation='relu', padding='same')(pool1)\n",
        "        pool2 = MaxPooling2D(pool_size=(2, 2))(conv2)\n",
        "\n",
        "        # Bloque Convolucional 3: Conv2D + MaxPooling\n",
        "        conv3 = Conv2D(filters=128, kernel_size=(3, 3), activation='relu', padding='same')(pool2)\n",
        "        pool3 = MaxPooling2D(pool_size=(2, 2))(conv3)\n",
        "\n",
        "        # Aplanado espacial a vector unidimensional\n",
        "        flat = Flatten()(pool3)\n",
        "\n",
        "        # Capa densa intermedia y Regularización por Dropout\n",
        "        dense1 = Dense(128, activation='relu')(flat)\n",
        "        drop = Dropout(rate=0.25)(dense1)\n",
        "\n",
        "        # Capa final de clasificación (11 órganos - activación Softmax)\n",
        "        output = Dense(units=2, activation='softmax')(drop)\n",
        "\n",
        "        model = Model(inputs=inputs, outputs=output)\n",
        "\n",
        "        # Compilar con el optimizador Adam y pérdidas adecuadas\n",
        "        model.compile(\n",
        "            optimizer=Adam(learning_rate=0.001),\n",
        "            loss='categorical_crossentropy',\n",
        "            metrics=['accuracy']\n",
        "        )\n",
        "        return model\n",
        "\n",
        "# Instanciar el clasificador\n",
        "cnn_model = CNNClasificador.build_model()"
      ],
      "execution_count": 14,
      "outputs": []
