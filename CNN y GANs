      "cell_type": "markdown",
      "source": [
        "### **1.1. Carga del Dataset**"
      ],
      "metadata": {
        "id": "g6U_v_kpScm5"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "zXoF-8LX_UtY",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "a17c760c-5b2b-455a-dacd-da85d63edaf5"
      },
      "source": [
        "# Definición del flag del dataset y obtención de metadatos\n",
        "data_flag_1 = 'pneumoniamnist'\n",
        "info_1 = INFO[data_flag_1]\n",
        "DataClass_1 = getattr(medmnist, info_1['python_class'])\n",
        "\n",
        "# Descargamos los datos para entrenamiento y test en tamaño 64x64 píxeles\n",
        "train_dataset_1 = DataClass_1(split='train', download=True, size=64)\n",
        "test_dataset_1 = DataClass_1(split='test', download=True, size=64)\n",
        "\n",
        "x_train_1 = train_dataset_1.imgs\n",
        "y_train_1 = train_dataset_1.labels\n",
        "x_test_1 = test_dataset_1.imgs\n",
        "y_test_1 = test_dataset_1.labels"
      ],
